{
  "name": "bounded-belief-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "qa:modern-sidebar": "npm run test:run && npm run lint",
    "preview": "vite preview",
    "generate:analysis": "tsx scripts/generate_authoritative_analysis.ts",
    "generate:headline-metrics": "tsx scripts/generate_headline_metrics.ts",
    "generate:phase1-validation": "tsx scripts/generate_phase1_validation.ts",
    "generate:lockbox-holdout": "tsx scripts/generate_lockbox_holdout.ts",
    "generate:c-dominance": "tsx scripts/generate_c_dominance_sensitivity.ts",
    "generate:2006-outlier": "tsx scripts/generate_2006_outlier_sensitivity.ts",
    "generate:tier-b-sweep": "tsx scripts/generate_tier_b_stability_sweep.ts",
    "check:no-hardcoded-headline": "tsx scripts/check_no_hardcoded_headline_metrics.ts",
    "check:manuscript-consistency": "tsx scripts/check_manuscript_consistency.ts",
    "check:section-references": "tsx scripts/check_section_references.ts",
    "verify:q1:core": "npm run generate:analysis && npm run generate:phase1-validation && npm run check:no-hardcoded-headline",
    "verify:q1:docs": "npm run check:manuscript-consistency && npm run check:section-references",
    "verify:q1:full": "npm run verify:q1:core && npm run verify:q1:docs",
    "verify:q1": "npm run verify:q1:core",
    "audit:search": "tsx scripts/generate_search_audits.ts",
    "replicate": "tsx scripts/replicate.ts",
    "ci:gate": "tsx scripts/ci_gate.ts",
    "q1:gate": "tsx scripts/q1_submission_gate.ts",
    "verify:all": "npm run audit:search && npm run test:run && npm run lint && npm run build",
    "build:wvs-constructs": "tsx scripts/build_wvs_constructs.ts",
    "build:wvs-constructs:dry": "tsx scripts/build_wvs_constructs.ts --dry-run",
    "verify:constructs": "tsx scripts/verify_constructs.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.525.0",
    "plotly.js-basic-dist-min": "^3.0.1",
    "plotly.js-dist-min": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^25.0.1",
    "@types/papaparse": "^5.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.6",
    "@types/react-katex": "^3.0.4",
    "@types/react-plotly.js": "^2.6.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "js-yaml": "^5.5.0",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.0.0"
  }
}
