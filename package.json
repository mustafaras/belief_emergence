{
  "name": "bounded-belief-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "qa:modern-sidebar": "npm run test:run && npm run lint",
    "preview": "vite preview",
    "generate:analysis": "tsx scripts/generate_authoritative_analysis.ts",
    "generate:headline-metrics": "tsx scripts/generate_headline_metrics.ts",
    "generate:phase1-validation": "tsx scripts/generate_phase1_validation.ts",
    "generate:lockbox-holdout": "tsx scripts/generate_lockbox_holdout.ts",
    "generate:c-dominance": "tsx scripts/generate_c_dominance_sensitivity.ts",
    "generate:2006-outlier": "tsx scripts/generate_2006_outlier_sensitivity.ts",
    "generate:tier-b-sweep": "tsx scripts/generate_tier_b_stability_sweep.ts",
    "check:no-hardcoded-headline": "tsx scripts/check_no_hardcoded_headline_metrics.ts",
    "check:manuscript-consistency": "tsx scripts/check_manuscript_consistency.ts",
    "check:section-references": "tsx scripts/check_section_references.ts",
    "verify:q1:core": "npm run generate:analysis && npm run generate:phase1-validation && npm run generate:kfold && npm run check:no-hardcoded-headline",
    "verify:q1:docs": "npm run check:manuscript-consistency && npm run check:section-references",
    "verify:q1:full": "npm run verify:q1:core && npm run verify:q1:docs",
    "verify:q1": "npm run verify:q1:core",
    "audit:search": "tsx scripts/generate_search_audits.ts",
    "replicate": "tsx scripts/replicate.ts",
    "ci:gate": "tsx scripts/ci_gate.ts",
    "q1:gate": "tsx scripts/q1_submission_gate.ts",
    "verify:all": "npm run audit:search && npm run test:run && npm run lint && npm run build",
    "build:wvs-constructs": "tsx scripts/build_wvs_constructs.ts",
    "build:wvs-constructs:dry": "tsx scripts/build_wvs_constructs.ts --dry-run",
    "verify:constructs": "tsx scripts/verify_constructs.ts",
    "generate:kfold": "tsx scripts/generate_kfold_validation.ts",
    "build:panel": "tsx scripts/build_canonical_panel.ts && tsx scripts/generate_construct_prevalence.ts",
    "build:panel:dry": "tsx scripts/build_canonical_panel.ts --dry-run",
    "generate:functional-form": "tsx scripts/generate_functional_form_comparison.ts",
    "generate:figures": "python3 scripts/make_fig_eval_pair.py && python3 scripts/make_fig_resid_pair.py",
    "generate:prevalence": "tsx scripts/generate_construct_prevalence.ts",
    "generate:collinearity": "tsx scripts/generate_collinearity_diagnostics.ts",
    "generate:collinearity-ablation": "tsx scripts/generate_collinearity_ablation.ts",
    "generate:zero-fill": "tsx scripts/generate_zero_fill_sensitivity.ts",
    "generate:r-collinearity": "tsx scripts/generate_r_collinearity_case.ts",
    "generate:gini-window": "tsx scripts/generate_gini_window_sensitivity.ts",
    "generate:coefficient-fit": "python3 scripts/fit_coefficients_v2.py",
    "generate:environment": "tsx scripts/generate_software_environment.ts",
    "generate:elasticity-bound": "tsx scripts/generate_elasticity_bound_sensitivity.ts",
    "generate:elasticity-profile": "python3 scripts/profile_elasticity.py",
    "check:ui-artifacts": "tsx scripts/check_ui_agrees_with_artifacts.ts",
    "check:render": "node scripts/render_check.cjs",
    "check:routes": "node scripts/route_check.cjs",
    "check:a11y": "node scripts/a11y_check.cjs",
    "check:evidence-index": "tsx scripts/check_evidence_index.ts",
    "check:description-numbers": "tsx scripts/check_description_numbers.ts",
    "check:dom-numbers": "tsx scripts/check_dom_numbers.ts",
    "generate:evidence-consumption": "tsx scripts/generate_evidence_consumption.ts",
    "check:construct-audit": "tsx scripts/check_construct_audit.ts",
    "check:support-picture": "tsx scripts/check_support_picture.ts",
    "check:limits": "tsx scripts/check_limits.ts",
    "check:bundle-budget": "tsx scripts/check_bundle_budget.ts",
    "check:visual-baselines": "tsx scripts/check_visual_baselines.ts",
    "generate:artifact-facts": "tsx scripts/generate_artifact_facts.ts",
    "check:surface-snapshot": "tsx scripts/check_surface_snapshot.ts",
    "generate:presets": "tsx scripts/generate_presets.ts",
    "check:presets": "tsx scripts/check_presets.ts"
  },
  "dependencies": {
    "framer-motion": "^12.23.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.525.0",
    "plotly.js-dist-min": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/node": "^25.0.1",
    "@types/papaparse": "^5.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.6",
    "@types/react-katex": "^3.0.4",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^26.1.0",
    "papaparse": "^5.5.3",
    "playwright-core": "^1.49.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.0.0"
  }
}
